    "quality:push": "node quality/run.mjs push",
    "quality:full": "node quality/run.mjs full"
  },
  "keywords": ["academy", "ai-agent", "claude-code", "portable-agent"],
  "author": "Joe Fernandez",
  "license": "MIT",
  "devDependencies": {
    "knip": "5.70.2"
